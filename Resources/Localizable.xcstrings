{
  "sourceLanguage": "es",
  "strings": {
    "%@ %@ W": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@ W"
          }
        }
      },
      "shouldTranslate": false
    },
    "%@ antes del objetivo, los procesos pesados pasan a los núcleos de eficiencia. Enfría mucho antes de tener que pausarlos.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vor dem Zielwert wechseln rechenintensive Prozesse auf die Effizienzkerne. Das kühlt deutlich, bevor sie pausiert werden müssen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ before the target, heavy processes move to the efficiency cores. It cools a lot before they ever need to be paused."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ antes del objetivo, los procesos pesados pasan a los núcleos de eficiencia. Enfría mucho antes de tener que pausarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ avant l’objectif, les processus lourds passent sur les cœurs à haute efficacité. Cela refroidit beaucoup avant de devoir les mettre en pause."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ prima dell’obiettivo, i processi pesanti passano ai core ad alta efficienza. Raffredda molto prima di doverli mettere in pausa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標の%@手前で、重いプロセスを高効率コアに移します。一時停止が必要になるずっと前から温度を下げられます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ antes da meta, os processos pesados passam para os núcleos de eficiência. Isso esfria bastante antes de precisar pausá-los."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在达到目标前 %@ 时，将繁重的进程移到能效核心。这样在需要暂停它们之前就能明显降温。"
          }
        }
      }
    },
