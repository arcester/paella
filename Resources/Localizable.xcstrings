    "Activa el interruptor de un proceso para marcarlo como ilimitado: la app no lo limitará nunca y se recuerda para la próxima vez.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere den Schalter eines Prozesses, um ihn als unbegrenzt zu markieren: Die App begrenzt ihn nie, und das wird für das nächste Mal gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on a process’s switch to mark it as unlimited: the app will never limit it, and it’s remembered for next time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el interruptor de un proceso para marcarlo como ilimitado: la app no lo limitará nunca y se recuerda para la próxima vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez l’interrupteur d’un processus pour le marquer comme illimité : l’app ne le limitera jamais, et ce choix est mémorisé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva l’interruttore di un processo per contrassegnarlo come illimitato: l’app non lo limiterà mai e la scelta viene ricordata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロセスのスイッチをオンにすると無制限に設定されます。アプリはそのプロセスを制限せず、次回も記憶されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative a chave de um processo para marcá-lo como ilimitado: o app nunca o limitará, e isso fica salvo para a próxima vez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开某个进程的开关即可将其标记为不限制：应用永远不会限制它，下次也会记住。"
          }
        }
      }
    },
