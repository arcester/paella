    "Los procesos nunca se pausan; solo se pasan a los núcleos de eficiencia.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prozesse werden nie pausiert, nur auf die Effizienzkerne verschoben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processes are never paused; they’re only moved to the efficiency cores."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los procesos nunca se pausan; solo se pasan a los núcleos de eficiencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les processus ne sont jamais mis en pause ; ils passent seulement sur les cœurs à haute efficacité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I processi non vengono mai messi in pausa; passano solo ai core ad alta efficienza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロセスは一時停止されず、高効率コアに移されるだけです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os processos nunca são pausados; só passam para os núcleos de eficiência."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进程从不暂停，只会被移到能效核心。"
          }
        }
      }
    },
    "Límites quitados. El control automático está desactivado.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzungen aufgehoben. Die automatische Regelung ist aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limits removed. Automatic control is off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Límites quitados. El control automático está desactivado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limites supprimées. Le contrôle automatique est désactivé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limiti rimossi. Il controllo automatico è disattivato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制限を解除しました。自動制御はオフです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limites removidos. O controle automático está desativado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已解除限制。自动控制已关闭。"
          }
        }
      }
    },
    "Media del último minuto: es la que usa el control para compararla con el objetivo.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittelwert der letzten Minute: der Wert, den die Regelung mit dem Zielwert vergleicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Average over the last minute: the value the controller compares with the target."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Media del último minuto: es la que usa el control para compararla con el objetivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moyenne de la dernière minute : c’est elle que le contrôle compare à l’objectif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Media dell’ultimo minuto: è quella che il controllo confronta con l’obiettivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近1分間の平均。制御が目標と比較する値です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Média do último minuto: é a que o controle compara com a meta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近一分钟的平均值：控制器用它与目标比较。"
          }
        }
      }
    },
