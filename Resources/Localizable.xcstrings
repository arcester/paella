    "El sensor más caliente en cada momento: reacciona al instante pero salta mucho.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der jeweils heißeste Sensor: reagiert sofort, schwankt aber stark."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hottest sensor at each moment: reacts instantly but jumps around a lot."
          }
        },
