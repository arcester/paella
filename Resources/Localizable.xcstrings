    "• Desde %@: los procesos pesados pasan a los núcleos de eficiencia (más lentos y fríos).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "• Ab %@: Rechenintensive Prozesse wechseln auf die Effizienzkerne (langsamer und kühler)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• From %@: heavy processes move to the efficiency cores (slower and cooler)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "• Desde %@: los procesos pesados pasan a los núcleos de eficiencia (más lentos y fríos)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Dès %@ : les processus lourds passent sur les cœurs à haute efficacité (plus lents et plus frais)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "• Da %@: i processi pesanti passano ai core ad alta efficienza (più lenti e più freschi)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "• %@以上：重いプロセスを高効率コアに移します（遅いが低温）。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "• A partir de %@: os processos pesados passam para os núcleos de eficiência (mais lentos e frios)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "• 从 %@ 起：繁重的进程移到能效核心（更慢、更凉）。"
          }
        }
      }
    }
  },
  "version": "1.0"
}