    "Ningún proceso está limitado.\nActiva el control automático para ajustar el objetivo.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Prozess ist begrenzt.\nAktiviere die automatische Regelung, um den Zielwert einzustellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No process is limited.\nTurn on automatic control to set the target."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún proceso está limitado.\nActiva el control automático para ajustar el objetivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun processus n’est limité.\nActivez le contrôle automatique pour régler l’objectif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun processo è limitato.\nAttiva il controllo automatico per regolare l’obiettivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制限中のプロセスはありません。\n目標を調整するには自動制御をオンにしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum processo está limitado.\nAtive o controle automático para ajustar a meta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有进程受到限制。\n打开自动控制以调整目标。"
          }
        }
      }
    },
