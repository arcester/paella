    "Solo la paellera; al limitar procesos se añade el porcentaje de ciclo.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die Pfanne; beim Begrenzen wird der Arbeitszyklus in Prozent ergänzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just the pan; when processes are limited, the duty cycle percentage is added."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo la paellera; al limitar procesos se añade el porcentaje de ciclo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement la poêle ; quand des processus sont limités, le pourcentage du cycle s’ajoute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo la padella; quando si limitano processi, si aggiunge la percentuale del ciclo."
