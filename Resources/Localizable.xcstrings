    "Un proceso limitado funcionará al menos el %@ del tiempo: como mucho %@ veces más lento.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein begrenzter Prozess läuft mindestens %1$@ der Zeit: höchstens %2$@-mal langsamer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A limited process will run at least %1$@ of the time: at most %2$@ times slower."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un proceso limitado funcionará al menos el %@ del tiempo: como mucho %@ veces más lento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un processus limité tournera au moins %1$@ du temps : au plus %2$@ fois plus lent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un processo limitato funzionerà almeno il %1$@ del tempo: al massimo %2$@ volte più lento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制限されたプロセスも時間の%1$@以上は動作します。遅くなるのは最大%2$@倍です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um processo limitado rodará pelo menos %1$@ do tempo: no máximo %2$@ vezes mais lento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受限进程至少运行 %1$@ 的时间：最多慢 %2$@ 倍。"
          }
        }
      }
    },
